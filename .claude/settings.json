{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm build)",
      "Bash(pnpm lint)",
      "Bash(pnpm preview)",
      "Bash(pnpm tsc *)",
      "Bash(npx tsc *)"
    ],
    "deny": [
      "Edit(src/components/ui/**)",
      "Write(src/components/ui/**)"
    ]
  }
}
